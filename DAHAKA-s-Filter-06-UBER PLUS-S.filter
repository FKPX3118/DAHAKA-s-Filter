	Rarity Normal
	Class == "Body Armours"
	AreaLevel >= 2
	AreaLevel <= 9
	SetTextColor 180 180 180
	SetBorderColor 0 0 0
	SetBackgroundColor 20 20 0 180
SetFontSize 18

Hide # %H3 $type->leveling->firstlevels $tier->threesocketedgear
	Sockets >= 3
	Rarity Normal Magic
	Class == "Boots" "Gloves" "Helmets" "Sceptres" "Shields" "Wands"
